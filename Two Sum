class Solution:
    def twoSum(self, nums: List[int], target: int) -> List[int]:
        hashh = {} # Create an empty hash map

        for i, n in enumerate(nums): # Add counter to nums list
            diff = target - n # Calculate the diff needed to search in hashmap
            if diff in hashh: # If it's present, return the index of the first value(already in hashmap) and the current index
                return [hashh[diff], i]

            hashh[n] = i # Else add the current num with it's index to the hashmap
        return
        
